{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["t2highlights"],
  "ios": {
    "iosModuleName": "T2HighlightsNative"
  },
  "android": {
    "androidNamespace": ["t2highlights"],
    "androidCxxLibName": "t2highlights"
  },
  "autolinking": {
    "T2Highlights": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridT2Highlights"
      }
    }
  },
  "ignorePaths": ["node_modules", "Vendor"]
}
