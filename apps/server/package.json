{
  "name": "t3",
  "version": "0.1.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pingdotgg/t3code",
    "directory": "apps/server"
  },
  "bin": {
    "t3": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=src --watch-path=../../packages --watch-path=package.json src/bin.ts",
    "dev:built": "vp run dev",
    "build:bundle": "vp pack",
    "build:exe": "node scripts/cli.ts build-exe",
    "start": "node dist/bin.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "record:codex-replay": "bun scripts/record-codex-app-server-replay-fixture.ts",
    "record:claude-replay": "bun scripts/record-claude-agent-sdk-replay-fixture.ts",
    "record:cursor-replay": "node --env-file-if-exists=../../.env --experimental-strip-types scripts/record-cursor-agent-sdk-replay-fixture.ts",
    "record:pi-replay": "node scripts/record-pi-rpc-replay-fixture.ts",
    "record:grok-replay": "node scripts/record-grok-acp-replay-fixture.ts",
    "record:fx-replay": "node scripts/record-fx-acp-replay-fixture.ts",
    "record:muse-replay": "node scripts/record-muse-msp-replay-fixture.ts",
    "generate": "graphqlgen",
    "generate:expo-schema": "node scripts/fetch-expo-schema.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.276",
    "@cursor/sdk": "1.0.38",
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@ff-labs/fff-node": "0.11.0",
    "@muse-code/sdk": "1.4.6",
    "@napi-rs/keyring": "^1.3.0",
    "@t2code/provider-acp": "workspace:*",
    "@t2code/provider-acp-registry": "workspace:*",
    "@t2code/provider-core": "workspace:*",
    "@t2code/provider-cursor": "workspace:*",
    "@t2code/provider-fx": "workspace:*",
    "@t2code/provider-grok": "workspace:*",
    "@t2code/provider-muse": "workspace:*",
    "@t2code/provider-opencode": "workspace:*",
    "@t2code/provider-pi": "workspace:*",
    "@t2code/source-control-azure-devops": "workspace:*",
    "@t2code/source-control-bitbucket": "workspace:*",
    "@t2code/source-control-core": "workspace:*",
    "@t2code/source-control-definitions": "workspace:*",
    "@t2code/source-control-forgejo": "workspace:*",
    "@t2code/source-control-gitcafe": "workspace:*",
    "@t2code/source-control-github": "workspace:*",
    "@t2code/source-control-gitlab": "workspace:*",
    "character-entities": "2.0.2",
    "diff": "8.0.3",
    "effect": "catalog:",
    "jose": "catalog:",
    "node-pty": "^1.2.0-beta.15",
    "playwright-core": "1.60.0",
    "proper-lockfile": "4.1.2",
    "saxes": "6.0.0",
    "stream-chain": "^4.2.5",
    "stream-json": "3.6.0",
    "undici": "catalog:",
    "yaml": "catalog:",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@effect/graphql-generator": "catalog:",
    "@effect/vitest": "catalog:",
    "@opencode-ai/sdk": "^1.3.15",
    "@t2code/contracts": "workspace:*",
    "@t2code/provider-testing": "workspace:*",
    "@t2code/secret-provider-core": "workspace:*",
    "@t2code/secret-provider-definitions": "workspace:*",
    "@t2code/secret-provider-onepassword": "workspace:*",
    "@t2code/shared": "workspace:*",
    "@t2code/source-control-testing": "workspace:*",
    "@t2code/ssh": "workspace:*",
    "@t2code/tailscale": "workspace:*",
    "@t2code/web": "workspace:*",
    "@types/node": "catalog:",
    "@types/proper-lockfile": "^4.1.4",
    "@types/yauzl": "^3.4.0",
    "effect-acp": "workspace:*",
    "effect-codex-app-server": "workspace:*",
    "graphql": "16.14.1",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.16 || ^23.11 || >=24.10"
  }
}
